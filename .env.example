# FinTrack — port configuratie
# Port van de API server (Express), zie server/index.ts
PORT=

# Port van de UI dev server (Vite), zie vite.config.ts
UI_PORT=

# Autentikasi aplikasi (wajib diisi)
AUTH_USERNAME=
AUTH_PASSWORD=

# Kunci HMAC untuk menandatangani cookie sesi (opsional).
# Bila kosong, server menurunkannya dari username + password.
AUTH_SECRET=

# Masa berlaku sesi dalam jam (opsional, default 168 = 7 hari).
AUTH_SESSION_HOURS=168
